{
  "name": "thangka-designer",
  "version": "1.0.0",
  "description": "Interactive multi-touch canvas application with WhatsApp and Facebook integration",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps",
    "clear-session": "node scripts/clear-session.js"
  },
  "keywords": [
    "electron",
    "canvas",
    "multitouch",
    "whatsapp",
    "facebook"
  ],
  "author": "IKnowHow",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "whatsapp-web.js": "^1.23.0",
    "qrcode": "^1.5.3",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.14.2"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "electron": "^27.1.2",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.iknowHow.thangka-designer",
    "productName": "Thangka Designer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/puppeteer/**/*",
      "**/node_modules/whatsapp-web.js/**/*"
    ]
  }
}
